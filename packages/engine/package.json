{
  "name": "@patchsprite/engine",
  "version": "0.1.0",
  "description": "Device maps for MIDI and SysEx devices: the map schema, a generic codec and framing engines (browser-safe), with map loading, the pedal lock and an RtMidi transport for Node.",
  "type": "module",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/patchsprite-app/patchsprite-sniffer.git",
    "directory": "packages/engine"
  },
  "engines": {
    "node": ">=22.18"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "node": "./dist/node/index.js"
    },
    "./canonical-json": {
      "types": "./dist/canonical-json.d.ts",
      "default": "./dist/canonical-json.js"
    },
    "./capture": {
      "types": "./dist/capture.d.ts",
      "default": "./dist/capture.js"
    },
    "./data-dir": {
      "types": "./dist/data-dir.d.ts",
      "node": "./dist/data-dir.js"
    },
    "./pedal-lock": {
      "types": "./dist/pedal-lock.d.ts",
      "node": "./dist/pedal-lock.js"
    },
    "./seed-patch": {
      "types": "./dist/seed-patch.d.ts",
      "default": "./dist/seed-patch.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "pedal-lock": "./dist/bin/pedal-lock.js"
  },
  "files": [
    "dist",
    "vectors"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "node scripts/build.ts",
    "prepublishOnly": "npm run build && node --test \"test/*.test.ts\""
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "zod": "4.6.7"
  }
}
