{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "header"
        },
        "format": {
          "type": "string",
          "const": "patchsprite-capture"
        },
        "version": {
          "type": "number",
          "const": 1
        },
        "session": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "startedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        "tool": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            }
          },
          "required": [
            "name",
            "version"
          ],
          "additionalProperties": false
        },
        "os": {
          "type": "object",
          "properties": {
            "platform": {
              "type": "string",
              "enum": [
                "win32",
                "darwin",
                "linux"
              ]
            },
            "release": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            }
          },
          "required": [
            "platform",
            "release"
          ],
          "additionalProperties": false
        },
        "method": {
          "type": "string",
          "enum": [
            "frida-winmm"
          ]
        },
        "device": {
          "type": "object",
          "properties": {
            "usb": {
              "type": "object",
              "properties": {
                "vid": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 65535
                },
                "pid": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 65535
                }
              },
              "required": [
                "vid",
                "pid"
              ],
              "additionalProperties": false
            },
            "ports": {
              "type": "object",
              "properties": {
                "in": {
                  "maxItems": 64,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  }
                },
                "out": {
                  "maxItems": 64,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  }
                }
              },
              "required": [
                "in",
                "out"
              ],
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "editor": {
          "type": "object",
          "properties": {
            "exe": {
              "type": "string",
              "minLength": 1,
              "maxLength": 260
            },
            "version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            }
          },
          "required": [
            "exe"
          ],
          "additionalProperties": false
        },
        "note": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      },
      "required": [
        "type",
        "format",
        "version",
        "session",
        "startedAt",
        "tool",
        "os",
        "method",
        "editor"
      ],
      "additionalProperties": false
    },
    {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "midi"
            },
            "t": {
              "type": "number",
              "minimum": 0
            },
            "hookT": {
              "type": "number",
              "minimum": 0
            },
            "dir": {
              "type": "string",
              "enum": [
                "in",
                "out"
              ]
            },
            "kind": {
              "type": "string",
              "enum": [
                "sysex",
                "short",
                "sysexError",
                "shortError"
              ]
            },
            "bytes": {
              "type": "string",
              "maxLength": 196608,
              "pattern": "^[0-9a-f]{2}( [0-9a-f]{2})*$"
            },
            "port": {
              "type": "string",
              "minLength": 1,
              "maxLength": 32
            },
            "flags": {
              "maxItems": 4,
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "clock",
                  "activeSensing",
                  "short",
                  "poll"
                ]
              }
            }
          },
          "required": [
            "type",
            "t",
            "dir",
            "kind",
            "bytes"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "event"
            },
            "t": {
              "type": "number",
              "minimum": 0
            },
            "kind": {
              "type": "string",
              "enum": [
                "attached",
                "detached",
                "portOpen",
                "portClose",
                "info",
                "warning",
                "error"
              ]
            },
            "dir": {
              "type": "string",
              "enum": [
                "in",
                "out"
              ]
            },
            "port": {
              "type": "string",
              "minLength": 1,
              "maxLength": 32
            },
            "device": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            },
            "pid": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            }
          },
          "required": [
            "type",
            "t",
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "stepStart"
            },
            "t": {
              "type": "number",
              "minimum": 0
            },
            "id": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000
            },
            "kind": {
              "type": "string",
              "enum": [
                "action",
                "idle",
                "selfTest",
                "manual"
              ]
            },
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "change": {
              "type": "object",
              "properties": {
                "control": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "before": {
                  "type": "string",
                  "maxLength": 200
                },
                "after": {
                  "type": "string",
                  "maxLength": 200
                }
              },
              "required": [
                "control",
                "before",
                "after"
              ],
              "additionalProperties": false
            },
            "before": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._-]{1,128}$"
            }
          },
          "required": [
            "type",
            "t",
            "id",
            "kind",
            "label"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "stepEnd"
            },
            "t": {
              "type": "number",
              "minimum": 0
            },
            "id": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000
            },
            "status": {
              "type": "string",
              "enum": [
                "quiet",
                "timeout",
                "aborted"
              ]
            },
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "change": {
              "type": "object",
              "properties": {
                "control": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "before": {
                  "type": "string",
                  "maxLength": 200
                },
                "after": {
                  "type": "string",
                  "maxLength": 200
                }
              },
              "required": [
                "control",
                "before",
                "after"
              ],
              "additionalProperties": false
            },
            "after": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._-]{1,128}$"
            },
            "note": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            }
          },
          "required": [
            "type",
            "t",
            "id",
            "status"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "end"
            },
            "t": {
              "type": "number",
              "minimum": 0
            },
            "reason": {
              "type": "string",
              "enum": [
                "stopped",
                "selfTestFailed",
                "error"
              ]
            },
            "text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            }
          },
          "required": [
            "type",
            "t",
            "reason"
          ],
          "additionalProperties": false
        }
      ]
    }
  ],
  "$id": "https://github.com/patchsprite-app/patchsprite-sniffer/schemas/capture-line.v1.schema.json",
  "title": "Patchsprite capture line",
  "description": "One line of a capture file (JSON Lines): the header on the first line, a record on every other. Format: docs/formats/capture.md. Rules across lines are in parseCapture (packages/engine/src/capture.ts)."
}
